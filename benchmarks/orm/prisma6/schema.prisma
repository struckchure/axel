generator client {
  provider = "prisma-client-js"
  output = "./generated"
  engineType = "library"
  previewFeatures = ["relationJoins"]
}
datasource db {
  provider = "postgresql"
  url = env("BENCH_DATABASE_URL")
}

model Account {
  id Int @id
  email String
  age Int
  active Boolean
  posts Post[]
  @@map("account")
}
model Post {
  id Int @id
  title String
  author Int
  user Account @relation(fields: [author], references: [id])
  @@map("post")
}
