  "functions": [
    {
      "Name": "axel_rw_base_1",
      "CreateSQL": "CREATE OR REPLACE FUNCTION \"axel_rw_base_1\"() RETURNS trigger AS $$\nBEGIN\n  IF TG_OP = 'UPDATE' THEN\n    NEW.\"updated_at\" := now();\n  END IF;\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;",
      "DropSQL": "DROP FUNCTION IF EXISTS \"axel_rw_base_1\"();"
    },
    {
      "Name": "axel_rw_post_1",
      "CreateSQL": "CREATE OR REPLACE FUNCTION \"axel_rw_post_1\"() RETURNS trigger AS $$\nBEGIN\n  IF TG_OP = 'INSERT' THEN\n    NEW.\"slug\" := NEW.\"content\";\n  END IF;\n  IF TG_OP = 'UPDATE' THEN\n    NEW.\"slug\" := NEW.\"content\";\n  END IF;\n  RETURN NEW;\nEND;\n$$ LANGUAGE plpgsql;",
      "DropSQL": "DROP FUNCTION IF EXISTS \"axel_rw_post_1\"();"
    }
  ],
  "triggers": [
    {
      "Name": "comment.rewrite.base",
      "CreateSQL": "CREATE TRIGGER \"trg_comment_rewrite_base\" BEFORE UPDATE ON \"comment\"\n  FOR EACH ROW EXECUTE FUNCTION \"axel_rw_base_1\"();",
      "DropSQL": "DROP TRIGGER IF EXISTS \"trg_comment_rewrite_base\" ON \"comment\";"
