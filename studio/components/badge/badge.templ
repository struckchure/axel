package badge

type Variant string
type Size string

const (
	VariantDefault     Variant = "default"
	VariantSecondary   Variant = "secondary"
	VariantOutline     Variant = "outline"
	VariantDestructive Variant = "destructive"
	VariantSuccess     Variant = "success"
	VariantWarning     Variant = "warning"
	VariantInfo        Variant = "info"

	SizeDefault Size = "default"
	SizeSm      Size = "sm"
	SizeLg      Size = "lg"
)

type Props struct {
	Variant    Variant
	Size       Size
	Class      string
	Title      string
	Attributes templ.Attributes
}

func variantClasses(v Variant) string {
	switch v {
	case VariantSecondary:
		return "bg-secondary text-secondary-foreground"
	case VariantOutline:
		return "border border-border text-foreground"
	case VariantDestructive:
		return "bg-destructive/15 text-destructive border border-destructive/30"
	case VariantSuccess:
		return "bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border border-emerald-500/30"
	case VariantWarning:
		return "bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30"
	case VariantInfo:
		return "bg-blue-500/15 text-blue-600 dark:text-blue-400 border border-blue-500/30"
	default:
		return "bg-primary text-primary-foreground"
	}
}

func sizeClasses(s Size) string {
	switch s {
	case SizeSm:
		return "text-[10px] px-1.5 py-0.2 rounded"
	case SizeLg:
		return "text-xs px-2.5 py-0.5 rounded-md"
	default:
		return "text-[11px] px-1.5 py-0.5 rounded-md font-medium"
	}
}

templ Badge(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
	}}
	<span
		class={ "inline-flex items-center gap-1 font-medium transition-colors select-none", variantClasses(p.Variant), sizeClasses(p.Size), p.Class }
		if p.Title != "" {
			title={ p.Title }
		}
		{ p.Attributes... }
	>
		{ children... }
	</span>
}
