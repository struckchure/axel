package table

type Props struct {
	Class      string
	Attributes templ.Attributes
}

templ Table(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
	}}
	<div class="relative w-full overflow-auto">
		<table class={ "w-full caption-bottom text-xs", p.Class } { p.Attributes... }>
			{ children... }
		</table>
	</div>
}

templ Header(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
	}}
	<thead class={ "[&_tr]:border-b bg-muted/50", p.Class } { p.Attributes... }>
		{ children... }
	</thead>
}

templ Body(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
	}}
	<tbody class={ "[&_tr:last-child]:border-0", p.Class } { p.Attributes... }>
		{ children... }
	</tbody>
}

templ Row(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
	}}
	<tr class={ "border-b border-border transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted", p.Class } { p.Attributes... }>
		{ children... }
	</tr>
}

templ Head(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
	}}
	<th class={ "h-8 px-3 text-left align-middle font-medium text-muted-foreground [&:has([role=checkbox])]:pr-0", p.Class } { p.Attributes... }>
		{ children... }
	</th>
}

templ Cell(props ...Props) {
	{{
		var p Props
		if len(props) > 0 {
			p = props[0]
		}
	}}
	<td class={ "p-3 align-middle [&:has([role=checkbox])]:pr-0", p.Class } { p.Attributes... }>
		{ children... }
	</td>
}
