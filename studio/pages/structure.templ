package pages

import (
	"github.com/struckchure/axel/studio/components/badge"
	"github.com/struckchure/axel/studio/components/card"
	"github.com/struckchure/axel/studio/components/icon"
	"github.com/struckchure/axel/studio/components/table"
	"github.com/struckchure/axel/studio/db"
)

templ structureView(v StudioView) {
	<div class="flex-1 min-h-0 overflow-auto p-6 max-w-5xl">
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Type Schema & Properties
				}
				@card.Description() {
					Columns, types, nullability, defaults, and relations for { v.Active.Name }.
				}
			}
			@card.Content() {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head() { Column }
							@table.Head() { Type }
							@table.Head() { Nullable }
							@table.Head() { Default }
							@table.Head() { Key / Relation }
						}
					}
					@table.Body() {
						for _, c := range v.Active.Columns {
							@structureRow(c)
						}
					}
				}
			}
		}
	</div>
}

templ structureRow(c db.Column) {
	@table.Row() {
		@table.Cell(table.Props{Class: "font-medium text-foreground"}) {
			{ c.Name }
		}
		@table.Cell(table.Props{Class: "font-mono text-xs"}) {
			<span class={ templ.KV("text-blue-600 dark:text-blue-400", c.IsLink), templ.KV("text-muted-foreground", !c.IsLink) }>{ c.DataType }</span>
			if c.SQLType != "" {
				<span class="text-muted-foreground/50 ml-1.5 font-sans text-[11px]">{ c.SQLType }</span>
			}
		}
		@table.Cell() {
			if c.Nullable {
				<span class="text-muted-foreground text-xs">nullable</span>
			} else {
				<span class="text-foreground text-xs font-medium">not null</span>
			}
		}
		@table.Cell(table.Props{Class: "font-mono text-xs text-muted-foreground"}) {
			if c.Default != "" {
				{ c.Default }
			} else {
				<span class="text-muted-foreground/40">—</span>
			}
		}
		@table.Cell() {
			if c.IsPrimaryKey {
				@badge.Badge(badge.Props{Variant: badge.VariantWarning, Size: badge.SizeSm}) {
					@icon.Key(icon.Props{Size: 11})
					PK
				}
			} else if c.IsForeignKey {
				@badge.Badge(badge.Props{Variant: badge.VariantInfo, Size: badge.SizeSm, Title: "References " + c.ForeignRef}) {
					@icon.Link(icon.Props{Size: 11})
					FK
				}
			} else if c.IsMulti {
				@badge.Badge(badge.Props{Variant: badge.VariantOutline, Size: badge.SizeSm}) {
					@icon.Link(icon.Props{Size: 11})
					multi
				}
			}
		}
	}
}
