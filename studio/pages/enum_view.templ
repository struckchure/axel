package pages

import (
	"fmt"

	"github.com/struckchure/axel/studio/components/badge"
	"github.com/struckchure/axel/studio/components/card"
	"github.com/struckchure/axel/studio/components/icon"
	"github.com/struckchure/axel/studio/components/table"
)

templ enumDetailView(v StudioView) {
	if v.ActiveEnum == nil {
		@emptyState(v)
	} else {
		{{ e := *v.ActiveEnum }}
		<div class="flex-1 min-h-0 overflow-y-auto p-6 space-y-6 max-w-5xl">
			<!-- Header -->
			<div class="flex items-center justify-between">
				<div class="space-y-1">
					<div class="flex items-center gap-2">
						<span class="text-primary">@icon.Enum(icon.Props{Size: 20})</span>
						<h2 class="text-xl font-bold tracking-tight text-foreground">{ e.Name }</h2>
						@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
							{ fmt.Sprintf("%d values", len(e.Values)) }
						}
					</div>
					<p class="text-xs text-muted-foreground">ASL Enum Type</p>
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Enum Values Card -->
				<div class="md:col-span-2">
					@card.Card() {
						@card.Header() {
							@card.Title() {
								Values
							}
							@card.Description() {
								Allowed string literals for this enum type.
							}
						}
						@card.Content() {
							@table.Table() {
								@table.Header() {
									@table.Row() {
										@table.Head(table.Props{Class: "w-12"}) { # }
										@table.Head() { Value }
										@table.Head(table.Props{Class: "text-right"}) { Tag }
									}
								}
								@table.Body() {
									for i, val := range e.Values {
										@table.Row() {
											@table.Cell(table.Props{Class: "font-mono text-muted-foreground text-[11px]"}) {
												{ fmt.Sprintf("%d", i+1) }
											}
											@table.Cell(table.Props{Class: "font-mono font-medium text-foreground"}) {
												'{ val }'
											}
											@table.Cell(table.Props{Class: "text-right"}) {
												@badge.Badge(badge.Props{Variant: badge.VariantOutline, Size: badge.SizeSm}) {
													{ val }
												}
											}
										}
									}
								}
							}
						}
					}
				</div>

				<!-- Usages Card -->
				<div>
					@card.Card() {
						@card.Header() {
							@card.Title() {
								Schema Usages
							}
							@card.Description() {
								Types and properties using { e.Name }.
							}
						}
						@card.Content() {
							if len(e.Usages) == 0 {
								<p class="text-xs text-muted-foreground py-2 italic">No property in the schema currently references this enum.</p>
							} else {
								<div class="space-y-2">
									for _, u := range e.Usages {
										<div class="flex items-center justify-between p-2 rounded-md bg-muted/40 border border-border text-xs">
											<div class="flex items-center gap-1.5 font-medium">
												<span class="text-muted-foreground">@icon.Table(icon.Props{Size: 13})</span>
												<span>{ u.Type }</span>
											</div>
											<span class="font-mono text-muted-foreground">.{ u.Property }</span>
										</div>
									}
								</div>
							}
						}
					}
				</div>
			</div>
		</div>
	}
}
