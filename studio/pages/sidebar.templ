package pages

import (
	"fmt"
	"strings"

	"github.com/struckchure/axel/studio/components/badge"
	"github.com/struckchure/axel/studio/components/icon"
	"github.com/struckchure/axel/studio/components/input"
	"github.com/struckchure/axel/studio/db"
)

templ sidebar(v StudioView) {
	<aside class="w-64 shrink-0 border-r border-border bg-sidebar flex flex-col select-none">
		<!-- Search Header -->
		<div class="p-3 border-b border-border">
			<div class="relative">
				<span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none">
					@icon.Search(icon.Props{Size: 13})
				</span>
				@input.Input(input.Props{
					Type:        "search",
					Placeholder: "Filter schema & queries…",
					OnInput:     "filterSidebar(this.value)",
					Class:       "pl-8 h-8 text-xs bg-background",
				})
			</div>
		</div>

		<!-- Nav Scroll Area with Collapsible Dropdown Sections (collapsed by default) -->
		<nav class="flex-1 overflow-y-auto p-2 space-y-2 text-xs" id="sidebar-nav">
			<!-- 1. Types Dropdown -->
			<details open?={ isSectionOpen(v, "types") } class="group/section sidebar-section" data-section="types">
				<summary class="flex items-center justify-between px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-sidebar-accent/50 rounded-md cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden transition-colors">
					<span class="flex items-center gap-1.5">
						<span class="text-muted-foreground transition-transform duration-150 group-open/section:rotate-90">
							@icon.ChevronRight(icon.Props{Size: 11})
						</span>
						@icon.Table(icon.Props{Size: 13})
						Types
					</span>
					@badge.Badge(badge.Props{Variant: badge.VariantOutline, Size: badge.SizeSm}) {
						{ fmt.Sprintf("%d", len(v.Tables)) }
					}
				</summary>
				<div class="space-y-0.5 mt-1 pl-1">
					for _, g := range groupBySchema(v.Tables) {
						if len(groupBySchema(v.Tables)) > 1 {
							<div class="px-3 pt-1 text-[10px] font-medium text-muted-foreground/60 uppercase">
								{ g.Schema }
							</div>
						}
						for _, t := range g.Tables {
							@typeSidebarLink(v, t)
						}
					}
					if len(v.Tables) == 0 {
						<div class="px-3 py-1 text-muted-foreground/50 italic text-[11px]">No types found</div>
					}
				</div>
			</details>

			<!-- 2. Enums Dropdown -->
			if len(v.Enums) > 0 {
				<details open?={ isSectionOpen(v, "enums") } class="group/section sidebar-section" data-section="enums">
					<summary class="flex items-center justify-between px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-sidebar-accent/50 rounded-md cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden transition-colors">
						<span class="flex items-center gap-1.5">
							<span class="text-muted-foreground transition-transform duration-150 group-open/section:rotate-90">
								@icon.ChevronRight(icon.Props{Size: 11})
							</span>
							@icon.Enum(icon.Props{Size: 13})
							Enum
						</span>
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Size: badge.SizeSm}) {
							{ fmt.Sprintf("%d", len(v.Enums)) }
						}
					</summary>
					<div class="space-y-0.5 mt-1 pl-1">
						for _, e := range v.Enums {
							@enumSidebarLink(v, e)
						}
					</div>
				</details>
			}

			<!-- 3. Scalars Dropdown -->
			if len(v.Scalars) > 0 {
				<details open?={ isSectionOpen(v, "scalars") } class="group/section sidebar-section" data-section="scalars">
					<summary class="flex items-center justify-between px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-sidebar-accent/50 rounded-md cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden transition-colors">
						<span class="flex items-center gap-1.5">
							<span class="text-muted-foreground transition-transform duration-150 group-open/section:rotate-90">
								@icon.ChevronRight(icon.Props{Size: 11})
							</span>
							@icon.Scalar(icon.Props{Size: 13})
							Scalar
						</span>
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Size: badge.SizeSm}) {
							{ fmt.Sprintf("%d", len(v.Scalars)) }
						}
					</summary>
					<div class="space-y-0.5 mt-1 pl-1">
						for _, s := range v.Scalars {
							@scalarSidebarLink(v, s)
						}
					</div>
				</details>
			}

			<!-- 4. Policies Dropdown -->
			if len(v.Policies) > 0 {
				<details open?={ isSectionOpen(v, "policies") } class="group/section sidebar-section" data-section="policies">
					<summary class="flex items-center justify-between px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-sidebar-accent/50 rounded-md cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden transition-colors">
						<span class="flex items-center gap-1.5">
							<span class="text-muted-foreground transition-transform duration-150 group-open/section:rotate-90">
								@icon.ChevronRight(icon.Props{Size: 11})
							</span>
							@icon.Policy(icon.Props{Size: 13})
							Policies
						</span>
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Size: badge.SizeSm}) {
							{ fmt.Sprintf("%d", len(v.Policies)) }
						}
					</summary>
					<div class="space-y-0.5 mt-1 pl-1">
						for _, p := range v.Policies {
							@policySidebarLink(v, p)
						}
					</div>
				</details>
			}

			<!-- 5. Triggers Dropdown -->
			if len(v.Triggers) > 0 {
				<details open?={ isSectionOpen(v, "triggers") } class="group/section sidebar-section" data-section="triggers">
					<summary class="flex items-center justify-between px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-sidebar-accent/50 rounded-md cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden transition-colors">
						<span class="flex items-center gap-1.5">
							<span class="text-muted-foreground transition-transform duration-150 group-open/section:rotate-90">
								@icon.ChevronRight(icon.Props{Size: 11})
							</span>
							@icon.Trigger(icon.Props{Size: 13})
							Triggers
						</span>
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Size: badge.SizeSm}) {
							{ fmt.Sprintf("%d", len(v.Triggers)) }
						}
					</summary>
					<div class="space-y-0.5 mt-1 pl-1">
						for _, t := range v.Triggers {
							@triggerSidebarLink(v, t)
						}
					</div>
				</details>
			}

			<!-- 6. Functions Dropdown -->
			if len(v.Functions) > 0 {
				<details open?={ isSectionOpen(v, "functions") } class="group/section sidebar-section" data-section="functions">
					<summary class="flex items-center justify-between px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-sidebar-accent/50 rounded-md cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden transition-colors">
						<span class="flex items-center gap-1.5">
							<span class="text-muted-foreground transition-transform duration-150 group-open/section:rotate-90">
								@icon.ChevronRight(icon.Props{Size: 11})
							</span>
							@icon.Function(icon.Props{Size: 13})
							Functions
						</span>
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Size: badge.SizeSm}) {
							{ fmt.Sprintf("%d", len(v.Functions)) }
						}
					</summary>
					<div class="space-y-0.5 mt-1 pl-1">
						for _, f := range v.Functions {
							@functionSidebarLink(v, f)
						}
					</div>
				</details>
			}

			<!-- 7. Extensions Dropdown -->
			if len(v.Extensions) > 0 {
				<details open?={ isSectionOpen(v, "extensions") } class="group/section sidebar-section" data-section="extensions">
					<summary class="flex items-center justify-between px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-sidebar-accent/50 rounded-md cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden transition-colors">
						<span class="flex items-center gap-1.5">
							<span class="text-muted-foreground transition-transform duration-150 group-open/section:rotate-90">
								@icon.ChevronRight(icon.Props{Size: 11})
							</span>
							@icon.Extension(icon.Props{Size: 13})
							Extensions
						</span>
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Size: badge.SizeSm}) {
							{ fmt.Sprintf("%d", len(v.Extensions)) }
						}
					</summary>
					<div class="space-y-0.5 mt-1 pl-1">
						for _, ext := range v.Extensions {
							@extensionSidebarLink(v, ext)
						}
					</div>
				</details>
			}

			<!-- 8. Queries Dropdown -->
			if len(v.Queries) > 0 {
				<details open?={ isSectionOpen(v, "queries") } class="group/section sidebar-section" data-section="queries">
					<summary class="flex items-center justify-between px-2 py-1.5 text-[11px] font-semibold uppercase tracking-wider text-muted-foreground hover:text-foreground hover:bg-sidebar-accent/50 rounded-md cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden transition-colors">
						<span class="flex items-center gap-1.5">
							<span class="text-muted-foreground transition-transform duration-150 group-open/section:rotate-90">
								@icon.ChevronRight(icon.Props{Size: 11})
							</span>
							@icon.Query(icon.Props{Size: 13})
							Queries
						</span>
						@badge.Badge(badge.Props{Variant: badge.VariantOutline, Size: badge.SizeSm}) {
							{ fmt.Sprintf("%d", len(v.Queries)) }
						}
					</summary>
					<div class="space-y-0.5 mt-1 pl-1">
						for _, q := range v.Queries {
							@querySidebarLink(v, q)
						}
					</div>
				</details>
			}
		</nav>

		<!-- Footer -->
		<div class="p-3 border-t border-border text-[11px] text-muted-foreground flex items-center justify-between">
			<span>Axel Studio</span>
			<span class="tabular-nums font-mono">{ fmt.Sprintf("%d types · %d queries", len(v.Tables), len(v.Queries)) }</span>
		</div>

		<script>
			// SPA sidebar active state click handler
			document.addEventListener("click", function (e) {
				const link = e.target.closest("#sidebar-nav a[data-filter-item]");
				if (!link) return;
				document.querySelectorAll("#sidebar-nav a[data-filter-item]").forEach(function (el) {
					el.classList.remove("bg-sidebar-accent", "text-sidebar-accent-foreground", "font-medium");
					el.classList.add("text-sidebar-foreground/80");
				});
				link.classList.add("bg-sidebar-accent", "text-sidebar-accent-foreground", "font-medium");
				link.classList.remove("text-sidebar-foreground/80");
			});
		</script>
	</aside>
}

func isSectionOpen(v StudioView, section string) bool {
	switch section {
	case "types":
		return v.ActiveKind == "type" && v.Active != nil
	case "enums":
		return v.ActiveKind == "enum" && v.ActiveEnum != nil
	case "scalars":
		return v.ActiveKind == "scalar" && v.ActiveScalar != nil
	case "policies":
		return v.ActiveKind == "policy" && v.ActivePolicy != nil
	case "triggers":
		return v.ActiveKind == "trigger" && v.ActiveTrigger != nil
	case "functions":
		return v.ActiveKind == "function" && v.ActiveFunction != nil
	case "extensions":
		return v.ActiveKind == "extension" && v.ActiveExtension != nil
	case "queries":
		return v.ActiveKind == "query" && v.ActiveQuery != nil
	default:
		return false
	}
}

templ typeSidebarLink(v StudioView, t db.Table) {
	<a
		href={ templ.SafeURL(tableURL(t)) }
		hx-get={ tableURL(t) }
		hx-target="#panel-container"
		hx-swap="innerHTML"
		hx-push-url="true"
		data-filter-item={ t.DisplayName() + " " + t.Name }
		class={
			"group flex items-center gap-2 px-2 py-1.5 rounded-md text-xs transition-colors cursor-pointer",
			templ.KV("bg-sidebar-accent text-sidebar-accent-foreground font-medium", isTypeActive(v, t)),
			templ.KV("text-sidebar-foreground/80 hover:bg-sidebar-accent/60 hover:text-sidebar-foreground", !isTypeActive(v, t)),
		}
	>
		<span class="text-muted-foreground group-hover:text-foreground">@icon.Table(icon.Props{Size: 14})</span>
		<span class="truncate flex-1 font-medium">{ t.DisplayName() }</span>
		if t.Rows > 0 {
			<span class="text-[10px] text-muted-foreground tabular-nums">{ comma(t.Rows) }</span>
		}
	</a>
}

templ enumSidebarLink(v StudioView, e db.EnumItem) {
	<a
		href={ templ.SafeURL(enumURL(e)) }
		hx-get={ enumURL(e) }
		hx-target="#panel-container"
		hx-swap="innerHTML"
		hx-push-url="true"
		data-filter-item={ e.Name }
		class={
			"group flex items-center gap-2 px-2 py-1.5 rounded-md text-xs transition-colors cursor-pointer",
			templ.KV("bg-sidebar-accent text-sidebar-accent-foreground font-medium", isEnumActive(v, e)),
			templ.KV("text-sidebar-foreground/80 hover:bg-sidebar-accent/60 hover:text-sidebar-foreground", !isEnumActive(v, e)),
		}
	>
		<span class="text-muted-foreground group-hover:text-foreground">@icon.Enum(icon.Props{Size: 14})</span>
		<span class="truncate flex-1 font-mono">{ e.Name }</span>
		<span class="text-[10px] text-muted-foreground tabular-nums">{ fmt.Sprintf("%d", len(e.Values)) }</span>
	</a>
}

templ scalarSidebarLink(v StudioView, s db.ScalarItem) {
	<a
		href={ templ.SafeURL(scalarURL(s)) }
		hx-get={ scalarURL(s) }
		hx-target="#panel-container"
		hx-swap="innerHTML"
		hx-push-url="true"
		data-filter-item={ s.Name }
		class={
			"group flex items-center gap-2 px-2 py-1.5 rounded-md text-xs transition-colors cursor-pointer",
			templ.KV("bg-sidebar-accent text-sidebar-accent-foreground font-medium", isScalarActive(v, s)),
			templ.KV("text-sidebar-foreground/80 hover:bg-sidebar-accent/60 hover:text-sidebar-foreground", !isScalarActive(v, s)),
		}
	>
		<span class="text-muted-foreground group-hover:text-foreground">@icon.Scalar(icon.Props{Size: 14})</span>
		<span class="truncate flex-1 font-mono">{ s.Name }</span>
		if s.Base != "" {
			<span class="text-[10px] text-muted-foreground/70">{ s.Base }</span>
		}
	</a>
}

templ policySidebarLink(v StudioView, p db.PolicyItem) {
	<a
		href={ templ.SafeURL(policyURL(p)) }
		hx-get={ policyURL(p) }
		hx-target="#panel-container"
		hx-swap="innerHTML"
		hx-push-url="true"
		data-filter-item={ p.Type + " " + p.Name }
		class={
			"group flex items-center gap-2 px-2 py-1.5 rounded-md text-xs transition-colors cursor-pointer",
			templ.KV("bg-sidebar-accent text-sidebar-accent-foreground font-medium", isPolicyActive(v, p)),
			templ.KV("text-sidebar-foreground/80 hover:bg-sidebar-accent/60 hover:text-sidebar-foreground", !isPolicyActive(v, p)),
		}
	>
		<span class="text-muted-foreground group-hover:text-foreground">@icon.Policy(icon.Props{Size: 14})</span>
		<span class="truncate flex-1">
			<span class="text-muted-foreground">{ p.Type }.</span>{ p.Name }
		</span>
		if len(p.Commands) > 0 {
			<span class="text-[10px] text-muted-foreground font-mono">{ strings.ToUpper(p.Commands[0]) }</span>
		}
	</a>
}

templ triggerSidebarLink(v StudioView, t db.TriggerItem) {
	<a
		href={ templ.SafeURL(triggerURL(t)) }
		hx-get={ triggerURL(t) }
		hx-target="#panel-container"
		hx-swap="innerHTML"
		hx-push-url="true"
		data-filter-item={ t.Type + " " + t.Name }
		class={
			"group flex items-center gap-2 px-2 py-1.5 rounded-md text-xs transition-colors cursor-pointer",
			templ.KV("bg-sidebar-accent text-sidebar-accent-foreground font-medium", isTriggerActive(v, t)),
			templ.KV("text-sidebar-foreground/80 hover:bg-sidebar-accent/60 hover:text-sidebar-foreground", !isTriggerActive(v, t)),
		}
	>
		<span class="text-muted-foreground group-hover:text-foreground">@icon.Trigger(icon.Props{Size: 14})</span>
		<span class="truncate flex-1">
			<span class="text-muted-foreground">{ t.Type }.</span>{ t.Name }
		</span>
		<span class="text-[10px] text-muted-foreground font-mono">{ strings.ToUpper(t.Timing) }</span>
	</a>
}

templ functionSidebarLink(v StudioView, f db.FunctionItem) {
	<a
		href={ templ.SafeURL(functionURL(f)) }
		hx-get={ functionURL(f) }
		hx-target="#panel-container"
		hx-swap="innerHTML"
		hx-push-url="true"
		data-filter-item={ f.Name }
		class={
			"group flex items-center gap-2 px-2 py-1.5 rounded-md text-xs transition-colors cursor-pointer",
			templ.KV("bg-sidebar-accent text-sidebar-accent-foreground font-medium", isFunctionActive(v, f)),
			templ.KV("text-sidebar-foreground/80 hover:bg-sidebar-accent/60 hover:text-sidebar-foreground", !isFunctionActive(v, f)),
		}
	>
		<span class="text-muted-foreground group-hover:text-foreground">@icon.Function(icon.Props{Size: 14})</span>
		<span class="truncate flex-1 font-mono">{ f.Name }()</span>
		if f.Returns != "" {
			<span class="text-[10px] text-muted-foreground font-mono">{ f.Returns }</span>
		}
	</a>
}

templ extensionSidebarLink(v StudioView, ext db.ExtensionItem) {
	<a
		href={ templ.SafeURL(extensionURL(ext)) }
		hx-get={ extensionURL(ext) }
		hx-target="#panel-container"
		hx-swap="innerHTML"
		hx-push-url="true"
		data-filter-item={ ext.Name }
		class={
			"group flex items-center gap-2 px-2 py-1.5 rounded-md text-xs transition-colors cursor-pointer",
			templ.KV("bg-sidebar-accent text-sidebar-accent-foreground font-medium", isExtensionActive(v, ext)),
			templ.KV("text-sidebar-foreground/80 hover:bg-sidebar-accent/60 hover:text-sidebar-foreground", !isExtensionActive(v, ext)),
		}
	>
		<span class="text-muted-foreground group-hover:text-foreground">@icon.Extension(icon.Props{Size: 14})</span>
		<span class="truncate flex-1 font-mono">{ ext.Name }</span>
	</a>
}

templ querySidebarLink(v StudioView, q db.QueryItem) {
	<a
		href={ templ.SafeURL(queryURL(q)) }
		hx-get={ queryURL(q) }
		hx-target="#panel-container"
		hx-swap="innerHTML"
		hx-push-url="true"
		data-filter-item={ q.Name }
		class={
			"group flex items-center gap-2 px-2 py-1.5 rounded-md text-xs transition-colors cursor-pointer",
			templ.KV("bg-sidebar-accent text-sidebar-accent-foreground font-medium", isQueryActive(v, q)),
			templ.KV("text-sidebar-foreground/80 hover:bg-sidebar-accent/60 hover:text-sidebar-foreground", !isQueryActive(v, q)),
		}
	>
		<span class="text-muted-foreground group-hover:text-foreground">@icon.Query(icon.Props{Size: 14})</span>
		<span class="truncate flex-1 font-mono">{ q.Name }</span>
		<span class="text-[10px] text-muted-foreground font-mono uppercase">{ q.Operation }</span>
	</a>
}
