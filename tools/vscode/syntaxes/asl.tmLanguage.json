{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Axel Schema",
  "scopeName": "source.asl",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#dollar-sql"
    },
    {
      "include": "#inline-aql"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#enum-block"
    },
    {
      "include": "#constraint-name"
    },
    {
      "include": "#policy-predicate"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#default-functions"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#types"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#field-ref"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "match": "#.*$",
      "name": "comment.line.number-sign.asl"
    },
    "strings": {
      "match": "'[^']*'",
      "name": "string.quoted.single.asl"
    },
    "enum-block": {
      "begin": "\\b(enum)\\s+([A-Z]\\w*)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "storage.type.asl"
        },
        "2": {
          "name": "entity.name.type.asl"
        },
        "3": {
          "name": "punctuation.bracket.asl"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.bracket.asl"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "\\b[A-Za-z_]\\w*\\b",
          "name": "constant.other.enum.asl"
        },
        {
          "match": ",",
          "name": "punctuation.delimiter.asl"
        }
      ]
    },
    "constraint-name": {
      "match": "\\b(constraint)\\s+([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "keyword.control.asl"
        },
        "2": {
          "name": "entity.name.function.asl"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(scalar|type|model|enum|abstract|function|use|extension|global)\\b",
          "name": "storage.type.asl"
        },
        {
          "match": "\\b(required|multi|single|property|link)\\b",
          "name": "storage.modifier.asl"
        },
        {
          "match": "@(for|language|immutable|stable|volatile|strict|leakproof|parallel|security|cost)\\b",
          "name": "keyword.control.directive.asl"
        },
        {
          "match": "\\b(extends|extending|constraint|index|on|filter|computed|default|func|rewrite|trigger|before|after|for|each|row|statement|when|do|execute|language|body|return|safe|unsafe|restricted|definer|invoker|policy|using|with|check|to)\\b",
          "name": "keyword.control.asl"
        }
      ]
    },
    "dollar-sql": {
      "begin": "\\$\\$",
      "end": "\\$\\$",
      "name": "string.quoted.other.dollar.asl",
      "contentName": "meta.embedded.block.sql"
    },
    "policy-predicate": {
      "comment": "RLS policy `using (…)` / `with check (…)` predicates are AQL — highlight their interior with the AQL grammar. #aql-parens (listed first) swallows any nested parens (e.g. now()) so the only bare `)` the region sees is its own matching close paren.",
      "begin": "\\b(using|with\\s+check)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.asl" },
        "2": { "name": "punctuation.section.parens.begin.asl" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.asl" }
      },
      "contentName": "meta.embedded.block.aql",
      "patterns": [
        { "include": "#aql-parens" },
        { "include": "source.aql" }
      ]
    },
    "inline-aql": {
      "comment": "An inline AQL query in a function body: aql`delete KV filter …`. The interior is a whole AQL statement, highlighted with the AQL grammar; the compiler compiles it and inlines the resulting SQL as a string literal.",
      "begin": "\\b(aql)\\s*(`)",
      "beginCaptures": {
        "1": { "name": "keyword.control.asl" },
        "2": { "name": "punctuation.definition.string.begin.asl" }
      },
      "end": "(`)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.asl" }
      },
      "contentName": "meta.embedded.block.aql",
      "patterns": [
        { "include": "source.aql" }
      ]
    },
    "aql-parens": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        { "include": "#aql-parens" },
        { "include": "source.aql" }
      ]
    },
    "builtins": {
      "match": "\\b(str|int16|int32|int64|float32|float64|bool|uuid|datetime|date|time|json|jsonb|bytes|decimal)\\b",
      "name": "support.type.builtin.asl"
    },
    "default-functions": {
      "match": "\\b(gen_uuid|gen_random_uuid|now|datetime_current)\\b",
      "name": "support.function.builtin.asl"
    },
    "booleans": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.boolean.asl"
    },
    "types": {
      "match": "\\b[A-Z]\\w*\\b",
      "name": "entity.name.type.asl"
    },
    "properties": {
      "match": "\\b[a-z_]\\w*\\b(?=\\s*:)",
      "name": "variable.other.property.asl"
    },
    "field-ref": {
      "match": "(\\.)([A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.delimiter.asl"
        },
        "2": {
          "name": "variable.other.property.asl"
        }
      }
    },
    "numbers": {
      "match": "\\b\\d+\\b",
      "name": "constant.numeric.asl"
    },
    "operators": {
      "match": ":=|\\?\\?|@",
      "name": "keyword.operator.asl"
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[{}()]",
          "name": "punctuation.bracket.asl"
        },
        {
          "match": "[;,:.]",
          "name": "punctuation.delimiter.asl"
        }
      ]
    }
  }
}
